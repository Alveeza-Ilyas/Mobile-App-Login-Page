<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Task">

    <de.hdodenhof.circleimageview.CircleImageView
        android:layout_width="wrap_content"
        android:layout_height="100dp"
        android:src="@drawable/wallpaper"
        android:layout_centerHorizontal="true"
        android:id="@+id/img1"
        android:layout_marginTop="10dp"
        />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Login"
        android:id="@+id/login"
        android:layout_below="@+id/img1"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="15dp"
        android:textSize="40sp"
        android:textStyle="bold"
        />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Email"
        android:id="@+id/email"
        android:layout_below="@+id/login"
        android:textSize="20dp"
        android:layout_marginLeft="20sp"
        android:textStyle="bold"
        />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Forgot Password?"
        android:id="@+id/forgotPass"
        android:layout_toRightOf="@+id/email"
        android:layout_below="@+id/login"
        android:layout_marginLeft="210dp"
        android:textColor="#1F4EAB"
        android:textSize="15sp"
        android:layout_marginRight="10dp"
        />

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="10dp"
        android:id="@+id/email2"
        android:layout_below="@+id/email"
        >

        <com.google.android.material.textfield.TextInputEditText
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Enter Email here"
            android:inputType="textEmailAddress"
            />

    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Password"
        android:id="@+id/password"
        android:layout_below="@+id/email2"
        android:textSize="20dp"
        android:layout_marginLeft="20sp"
        android:textStyle="bold"
        />

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="10dp"
        android:id="@+id/password3"
        android:layout_below="@+id/password"
        app:endIconMode="password_toggle"
        >
        <com.google.android.material.textfield.TextInputEditText
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Enter Password here"
            android:inputType="textPassword"
            />

    </com.google.android.material.textfield.TextInputLayout>

    <Button
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Log In"
        android:id="@+id/Button1"
        android:layout_below="@+id/password3"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="30dp"
        android:paddingHorizontal="90dp"
        android:paddingVertical="10dp"
        android:textSize="20sp"
        android:backgroundTint="#3F51B5"
        />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:text="--------------------- or continue with ----------------------"
        android:id="@+id/orContinueWith"
        android:layout_below="@id/Button1"
        android:layout_marginTop="20dp"
        />

    <androidx.cardview.widget.CardView
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_below="@+id/orContinueWith"
        android:id="@+id/card"
        android:elevation="4dp"
        android:layout_marginTop="30dp"
        android:layout_marginLeft="90dp"
        app:cardCornerRadius="30dp"
        >

        <de.hdodenhof.circleimageview.CircleImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/google"
            android:id="@+id/img2"
            android:layout_below="@+id/orContinueWith"
            android:layout_marginTop="10dp"
            />

    </androidx.cardview.widget.CardView>

    <androidx.cardview.widget.CardView
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_below="@+id/orContinueWith"
        android:id="@+id/card2"
        android:elevation="4dp"
        android:layout_marginTop="30dp"
        android:layout_marginLeft="70dp"
        app:cardCornerRadius="30dp"
        android:layout_toRightOf="@+id/card"
        >

        <de.hdodenhof.circleimageview.CircleImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/facebook"
            android:id="@+id/img3"
            android:layout_below="@+id/orContinueWith"
            android:layout_marginTop="10dp"
            />

    </androidx.cardview.widget.CardView>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Don't have an account? "
        android:id="@+id/noAccount"
        android:layout_below="@+id/card"
        android:layout_marginTop="50dp"
        android:layout_marginLeft="90dp"
        android:textSize="15sp"
        />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Sign Up"
        android:id="@+id/signup"
        android:layout_below="@+id/card"
        android:layout_marginTop="50dp"
        android:layout_toRightOf="@+id/noAccount"
        android:textColor="#1944AF"
        android:textSize="15sp"
        />

</RelativeLayout>
